# Port the API listens on
PORT=4000

# MongoDB connection string. Local:
MONGODB_URI=mongodb://127.0.0.1:27017/task-tracker
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-tracker

# Browser origins allowed to call the API (CORS), comma-separated.
# Leave unset locally: the API is then open to every origin (the Vite dev proxy is same-origin anyway).
# Set it in production (Vercel: Settings > Environment Variables), for example:
# CORS_ORIGINS=https://task-home-seven.vercel.app
# Several origins: CORS_ORIGINS=https://task-home-seven.vercel.app,https://tracker.example.com
